# Sub-packages (generated icon libraries & packages)
# Never upload installed deps or package build output.
**/node_modules/
/packages/*/dist/
/apps/*/dist/

# Local build, dev, and cache outputs
/dist/
/build/
/.wrangler/
/coverage/
.DS_Store
*.log

# Environment files
.env
.env.*
!.env.example

# Repository workflows & AI agent metadata
/.github/
/.agents/
/scratch/
*.test.*
*.spec.*
