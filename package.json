{
  "name": "reicon-docs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "node scripts/sync-icon-names.mjs && node scripts/seo/update-helmets.mjs && node scripts/generate-sitemap.mjs && node scripts/generate-llm-assets.mjs && vite build && node scripts/prerender-meta.mjs",
    "build:full": "npm run build",
    "postbuild": "node scripts/seo/ping.mjs",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "helmets": "node scripts/seo/update-helmets.mjs",
    "ping": "node scripts/seo/ping.mjs",
    "seo:check": "node scripts/seo/test.mjs",
    "sync:icons": "node scripts/sync-icon-names.mjs",
    "validate:icons": "node scripts/validate-icons.mjs",
    "seo": "node scripts/seo/update.mjs",
    "build:react": "node packages/reicon-react/scripts/build.cjs",
    "build:react-native": "node packages/reicon-react-native/scripts/build.cjs",
    "build:vue": "node packages/reicon-vue/scripts/build.cjs",
    "build:js": "node packages/reicon/scripts/build.cjs",
    "build:cdn:min": "npx terser packages/reicon/dist/cdn/reicon.js --compress --mangle -o packages/reicon/dist/cdn/reicon.js",
    "build:figma": "node packages/reicon-figma/scripts/build.cjs",
    "build:svelte": "node packages/reicon-svelte/scripts/build.cjs",
    "build:vscode": "node packages/reicon-vscode/scripts/build.cjs",
    "build:mcp": "node packages/reicon-mcp/scripts/build.cjs",
    "bump:versions": "node scripts/bump-versions.mjs",
    "build:packages": "node scripts/sync-icon-names.mjs && npm run build:react && npm run build:react-native && npm run build:vue && npm run build:js && npm run build:cdn:min && npm run build:figma && npm run build:svelte && npm run build:vscode && npm run build:mcp",
    "preview": "npm run build && wrangler dev",
    "clean": "rm -rf dist packages/*/dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.19",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "jszip": "^3.10.1",
    "lenis": "^1.3.23",
    "motion": "^12.40.0",
    "react": "^19.0.1",
    "react-colorful": "^5.7.0",
    "react-dom": "^19.0.1",
    "react-helmet-async": "^3.0.0",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.6.0",
    "reicon-react": "^1.0.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.45.1",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.21",
    "jsdom": "^29.1.1",
    "posthog-node": "^5.34.6",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.10",
    "vue": "^3.5.39",
    "wrangler": "^4.112.0",
    "zod": "^3.24.0"
  }
}
