{
  "name": "reicon-docs",
  "private": true,
  "version": "1.4.1",
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-website-search-index.mjs && vite --port=3000 --host=0.0.0.0",
    "build": "node scripts/generate-website-search-index.mjs && node scripts/sync-icon-names.mjs && node scripts/seo/update-helmets.mjs && node scripts/generate-sitemap.mjs && node scripts/generate-llm-assets.mjs && vite build && node scripts/prerender-meta.mjs",
    "build:full": "npm run build",
    "postbuild": "node scripts/seo/ping.mjs",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "helmets": "node scripts/seo/update-helmets.mjs",
    "ping": "node scripts/seo/ping.mjs",
    "seo:check": "node scripts/seo/test.mjs",
    "sync:icons": "node scripts/sync-icon-names.mjs",
    "validate:icons": "node scripts/validate-icons.mjs",
    "seo": "node scripts/seo/update.mjs",
    "build:react": "node packages/reicon-react/scripts/build.cjs",
    "build:react-native": "node packages/reicon-react-native/scripts/build.cjs",
    "build:vue": "node packages/reicon-vue/scripts/build.cjs",
    "build:js": "node packages/reicon/scripts/build.cjs",
    "build:cdn:min": "npx terser packages/reicon/dist/cdn/reicon.js --compress --mangle -o packages/reicon/dist/cdn/reicon.js",
    "build:figma": "node packages/reicon-figma/scripts/build.cjs",
    "build:svelte": "node packages/reicon-svelte/scripts/build.cjs",
    "build:astro": "node packages/reicon-astro/scripts/build.cjs",
    "build:angular": "node packages/reicon-angular/scripts/build.cjs",
    "build:vscode": "node packages/reicon-vscode/scripts/build.cjs",
    "build:mcp": "node packages/reicon-mcp/scripts/build.cjs",
    "bump:versions": "node scripts/bump-versions.mjs",
    "build:packages": "node scripts/sync-icon-names.mjs && npm run build:react && npm run build:react-native && npm run build:vue && npm run build:js && npm run build:cdn:min && npm run build:figma && npm run build:svelte && npm run build:astro && npm run build:angular && npm run build:vscode && npm run build:mcp",
    "preview": "npm run build && wrangler dev",
    "clean": "rm -rf dist packages/*/dist .vercel .vite .cache node_modules/.cache",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "deploy": "npm run build && wrangler deploy",
    "deploy:vercel": "vercel deploy --archive=tgz",
    "deploy:vercel:prod": "vercel deploy --prod --archive=tgz"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@tailwindcss/vite": "^4.3.3",
    "@vercel/speed-insights": "^2.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "dodopayments": "^2.50.0",
    "dodopayments-checkout": "^1.9.9",
    "jszip": "^3.10.2",
    "lenis": "^1.3.26",
    "motion": "^12.40.0",
    "react": "^19.3.0",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.3.0",
    "react-helmet-async": "^3.0.0",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.6.0",
    "reicon-react": "^1.2.5"
  },
  "devDependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/compiler-cli": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@cloudflare/vite-plugin": "^1.46.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.5.6",
    "jsdom": "^29.1.1",
    "ng-packagr": "^20.3.0",
    "posthog-node": "^5.52.1",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.10",
    "vue": "^3.5.42",
    "wrangler": "^4.112.0",
    "zod": "^3.24.0"
  }
}
